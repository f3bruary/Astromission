							id="theme-icon-dark"
							class="absolute inset-0 flex size-full items-center justify-center opacity-0 transition-opacity duration-200 ease-in"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								viewBox="0 0 16 16"
								fill="currentColor"
